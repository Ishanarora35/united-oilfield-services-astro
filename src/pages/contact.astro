---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
import { site } from '@/data/site';
import contactHeroImg from '@/assets/home/hero-3-pipelines-sunset.jpg';

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  '2472 Millview, Zeeland, Michigan, USA',
)}`;
---

<BaseLayout
  title="Contact"
  description="Contact United Oilfield Services LLC — 2472, Millview, Zeeland, Michigan, USA. Call 616-210-9891 or email office@unitedoilfields.com to discuss your oilfield requirements."
>
  <PageHero
    eyebrow="Contact"
    title="Get in Touch"
    lead="Tell us about your operation, your location and your timeline. We will put the right team on it."
    image={contactHeroImg}
    imageAlt="Gathering pipelines converging toward the horizon at sunset"
    objectPosition="50% 50%"
  />

  <section class="section contact">
    <div class="shell">
      <div class="contact__grid">
        <!-- Details -->
        <aside class="contact__details reveal">
          <h2 class="contact__h">Direct contact</h2>
          <span class="angled-rule angled-rule--sm"></span>

          <ul class="dl">
            <li>
              <span class="dl__k">Telephone</span>
              <a href={site.contact.phoneHref} class="dl__v dl__v--lg">{site.contact.phone}</a>
            </li>
            <li>
              <span class="dl__k">Email</span>
              <a href={site.contact.emailHref} class="dl__v dl__v--lg dl__v--break">
                {site.contact.email}
              </a>
            </li>
            <li>
              <span class="dl__k">Address</span>
              <address class="dl__v">
                <span class="dl__company">{site.name}</span>
                {site.contact.addressLines.map((l) => <span>{l}</span>)}
              </address>
              <a
                href={mapsUrl}
                class="link-arrow dl__map"
                target="_blank"
                rel="noopener noreferrer"
              >
                Open in Maps
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
                  <path d="M1 6h13M9.5 1 14.5 6l-5 5" stroke="currentColor" stroke-width="2"></path>
                </svg>
              </a>
            </li>
          </ul>

          <div class="contact__careers">
            <h3 class="contact__sub">Looking for work?</h3>
            <p>
              We are always looking for dedicated, safety-minded professionals to join our growing
              team.
            </p>
            <a href="/careers" class="link-arrow">
              Careers at UOS
              <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
                <path d="M1 6h13M9.5 1 14.5 6l-5 5" stroke="currentColor" stroke-width="2"></path>
              </svg>
            </a>
          </div>
        </aside>

        <!-- Form -->
        <div class="contact__form reveal" style="--reveal-delay:100ms">
          <h2 class="contact__h">Send an inquiry</h2>
          <span class="angled-rule angled-rule--sm"></span>
          <p class="contact__intro">
            Complete the form and we will get back to you. Prefer to talk it through? Call
            <a href={site.contact.phoneHref}>{site.contact.phone}</a>.
          </p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Location band -->
  <section class="loc bg-dark grid-texture">
    <div class="shell">
      <div class="loc__inner reveal">
        <div>
          <p class="eyebrow">Our location</p>
          <p class="loc__addr">
            {site.contact.addressLines.map((l) => <span>{l}</span>)}
          </p>
        </div>
        <a href={mapsUrl} class="btn btn--accent" target="_blank" rel="noopener noreferrer">
          Get Directions
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M21 10c0 6-9 13-9 13s-9-7-9-13a9 9 0 0 1 18 0Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
            <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"></circle>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }
  .contact__h {
    font-size: var(--fs-h3);
    color: var(--navy-800);
    margin-bottom: 1.1rem;
  }
  .contact__intro {
    margin-top: 1.5rem;
    margin-bottom: 2rem;
    color: var(--text-soft);
    max-width: 54ch;
  }
  .contact__intro a {
    color: var(--navy-800);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dl {
    display: grid;
    gap: 0;
    margin-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .dl li {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--rule);
  }
  .dl__k {
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--orange-ink);
  }
  .dl__v {
    font-size: var(--fs-body);
    color: var(--text);
    font-style: normal;
    display: grid;
    gap: 0.15rem;
  }
  .dl__v--lg {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--navy-800);
    transition: color 0.25s var(--ease);
  }
  a.dl__v--lg:hover {
    color: var(--orange-600);
  }
  .dl__v--break {
    word-break: break-word;
  }
  .dl__company {
    font-weight: 600;
    color: var(--navy-800);
  }
  .dl__map {
    margin-top: 0.9rem;
    font-size: 0.85rem;
  }

  .contact__careers {
    margin-top: 2.5rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--steel-50);
    border-left: 4px solid var(--orange-500);
  }
  .contact__sub {
    font-size: var(--fs-h4);
    color: var(--navy-800);
    margin-bottom: 0.6rem;
  }
  .contact__careers p {
    color: var(--text-soft);
    font-size: var(--fs-small);
    margin-bottom: 1.1rem;
  }

  /* Location band */
  .loc {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .loc__inner {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  .loc__addr {
    display: grid;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    text-transform: uppercase;
    color: #fff;
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .loc__inner {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }
</style>
