---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTASection from '@/components/CTASection.astro';
import Arrow from '@/components/Arrow.astro';
import safetyImg from '@/assets/safety/safety-environment.jpg';

const pillars = [
  {
    k: 'Every project, every scale',
    v: 'Every project, regardless of scale, begins with strict adherence to our rigorous HSE guidelines.',
  },
  {
    k: 'People and communities',
    v: 'Our guidelines protect our team, our clients, and the communities where we operate.',
  },
  {
    k: 'Environmental stewardship',
    v: 'Environmental stewardship sits alongside safety as a top priority on every job we take on.',
  },
];

const training = [
  {
    k: 'Extensive onboarding',
    v: 'All new hires complete extensive onboarding before they work on a location.',
  },
  {
    k: 'Customer-specific protocols',
    v: 'Onboarding is tailored to both our internal protocols and those of our customers.',
  },
  {
    k: 'Continuous training',
    v: 'Training continues throughout employment, supplementing initial onboarding.',
  },
  {
    k: 'Evolving industry policies',
    v: 'Programs are updated as industry policies evolve, so standards never drift.',
  },
];
---

<BaseLayout
  title="Safety & Environment"
  description="Safety and environmental stewardship are the top priorities at United Oilfield Services. Every project begins with strict adherence to rigorous HSE guidelines, supported by a compliance team with over 40 years of combined oilfield experience."
>
  <!-- ============ HERO ============ -->
  <section class="shero on-dark">
    <div class="shero__media">
      <Image
        src={safetyImg}
        alt="Hard hat, safety glasses, gloves and hearing protection laid out in front of an energy processing facility at sunset"
        widths={[800, 1280, 1753]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={84}
      />
      <span class="photo-scrim" aria-hidden="true"></span>
    </div>
    <div class="shero__plate-wrap">
      <div class="shero__plate">
        <p class="eyebrow">Safety &amp; Environment</p>
        <h1 class="shero__title">Safety &amp; Environmental Excellence</h1>
        <span class="angled-rule shero__rule"></span>
        <p class="shero__lead">
          Safety and environmental stewardship are our top priorities — on every project, at every
          scale.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ COMMITMENT ============ -->
  <section class="section">
    <div class="shell">
      <div class="commit">
        <div class="commit__aside reveal">
          <p class="eyebrow">Our commitment</p>
        </div>
        <div class="commit__body reveal" style="--reveal-delay:90ms">
          <p class="commit__lede">
            Every project, regardless of scale, begins with strict adherence to our rigorous HSE
            guidelines.
          </p>
          <div class="prose">
            <p>
              These guidelines protect our team, our clients, and the communities where we
              operate. Safety is not a stage of the job — it is the standard every stage is held
              to.
            </p>
          </div>
        </div>
      </div>

      <div class="pillars">
        {
          pillars.map((p, i) => (
            <article class="pillar reveal" style={`--reveal-delay:${i * 90}ms`}>
              <span class="pillar__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="pillar__k">{p.k}</h2>
              <p class="pillar__v">{p.v}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ COMPLIANCE TEAM ============ -->
  <section class="section compliance bg-dark grid-texture on-dark">
    <div class="shell">
      <div class="compliance__grid">
        <div class="compliance__figure reveal">
          <p class="compliance__big" aria-hidden="true">40<span>+</span></p>
          <p class="compliance__cap">
            years of <em>combined</em> oilfield experience among our dedicated compliance personnel
          </p>
        </div>
        <div class="compliance__body reveal" style="--reveal-delay:110ms">
          <p class="eyebrow">Compliance personnel</p>
          <h2 class="compliance__title">A dedicated team holding the standard</h2>
          <span class="angled-rule"></span>
          <div class="prose compliance__prose">
            <p>
              United Oilfield Services features a dedicated team of compliance personnel with over
              <strong>40 years of combined oilfield experience</strong>. That depth is what allows
              us to apply consistent HSE standards across very different sites, clients and
              operating conditions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRAINING ============ -->
  <section class="section bg-alt">
    <div class="shell">
      <div class="training">
        <div class="training__head reveal">
          <p class="eyebrow">Onboarding &amp; training</p>
          <h2 class="training__title">How we maintain these elite standards</h2>
          <span class="angled-rule"></span>
          <p class="lead training__lead">
            All new hires complete extensive onboarding tailored to both our internal protocols and
            those of our customers, supplemented by continuous training as industry policies evolve.
          </p>
        </div>

        <ol class="training__steps">
          {
            training.map((t, i) => (
              <li class="step reveal" style={`--reveal-delay:${i * 80}ms`}>
                <span class="step__n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="step__k">{t.k}</h3>
                  <p class="step__v">{t.v}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ CLOSING STATEMENT ============ -->
  <section class="closing">
    <div class="shell">
      <div class="closing__inner reveal">
        <p class="closing__quote">
          Every project is executed to the highest safety and quality standards in the industry.
        </p>
        <div class="btn-row closing__actions">
          <a href="/contact" class="btn btn--accent">Get in Touch<Arrow /></a>
          <a href="/services" class="btn btn--on-dark">Explore Our Services</a>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Careers"
    title="Join a safety-minded team"
    body="We are always looking for dedicated, safety-minded professionals to join our growing team."
    primaryLabel="Send Your Resume"
    primaryHref="/careers"
    secondaryLabel="Contact UOS"
    secondaryHref="/contact"
  />
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .shero {
    position: relative;
    background: var(--navy-900);
    color: #fff;
    display: grid;
  }
  .shero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .shero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 50%;
  }
  .shero__media .photo-scrim {
    z-index: 1;
  }
  .shero__plate-wrap {
    position: relative;
    z-index: 2;
  }
  .shero__plate {
    background: var(--navy-800);
    padding: clamp(1.75rem, 5vw, 3rem) var(--gutter) clamp(2rem, 5vw, 3rem);
    position: relative;
  }
  .shero__plate::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 96px;
    height: 5px;
    background: var(--orange-500);
  }
  .shero__title {
    font-size: var(--fs-hero);
    line-height: 1.02;
    color: #fff;
    margin-top: 1.1rem;
    max-width: 22ch;
    text-shadow: 0 2px 18px rgba(0, 12, 36, 0.5);
  }
  .shero__rule {
    margin-top: 1.5rem;
  }
  .shero__lead {
    margin-top: 1.35rem;
    max-width: 50ch;
    font-size: var(--fs-body-lg);
    color: #dce4f0;
    text-shadow: 0 1px 12px rgba(0, 12, 36, 0.55);
  }

  /* ---------- COMMITMENT ---------- */
  .commit {
    display: grid;
    gap: 1.5rem;
  }
  .commit__lede {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 2vw, 2.9rem);
    font-weight: 600;
    line-height: 1.13;
    text-transform: uppercase;
    color: var(--navy-800);
    max-width: 22ch;
    margin-bottom: 1.75rem;
  }

  .pillars {
    display: grid;
    gap: 0;
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 3px solid var(--navy-800);
  }
  .pillar {
    display: grid;
    gap: 0.65rem;
    align-content: start;
    padding-block: clamp(1.6rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .pillar__n {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--orange-ink);
  }
  .pillar__k {
    font-size: var(--fs-h4);
    color: var(--navy-800);
  }
  .pillar__v {
    color: var(--text-soft);
    font-size: var(--fs-body);
    max-width: 42ch;
  }

  /* ---------- COMPLIANCE ---------- */
  .compliance__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .compliance__big {
    font-family: var(--font-display);
    font-size: clamp(6rem, 4rem + 14vw, 15rem);
    font-weight: 700;
    line-height: 0.78;
    color: #fff;
    letter-spacing: -0.03em;
  }
  .compliance__big span {
    color: var(--orange-500);
  }
  .compliance__cap {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-invert-soft);
    max-width: 26ch;
  }
  .compliance__cap em {
    color: #fff;
    font-style: normal;
  }
  .compliance__title {
    font-size: var(--fs-h2);
    margin-block: 1.1rem;
    max-width: 15ch;
  }
  .compliance__prose {
    margin-top: 1.75rem;
  }

  /* ---------- TRAINING ---------- */
  .training {
    display: grid;
    gap: clamp(2.25rem, 4vw, 4rem);
  }
  .training__title {
    font-size: var(--fs-h2);
    color: var(--navy-800);
    margin-block: 1.1rem 1.4rem;
    max-width: 15ch;
  }
  .training__lead {
    margin-top: 1.5rem;
  }
  .training__steps {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.15rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .step__n {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--orange-ink);
    padding-top: 0.3em;
    font-variant-numeric: tabular-nums;
  }
  .step__k {
    font-size: var(--fs-h4);
    color: var(--navy-800);
  }
  .step__v {
    margin-top: 0.35rem;
    color: var(--text-soft);
    font-size: var(--fs-body);
    max-width: 52ch;
  }

  /* ---------- CLOSING ---------- */
  .closing {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    background: var(--navy-800);
    color: #fff;
    position: relative;
  }
  .closing::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 5px;
    background: linear-gradient(to right, var(--navy-700) 0 55%, var(--orange-500) 55%);
  }
  .closing__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .closing__quote {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.75rem);
    font-weight: 600;
    line-height: 1.14;
    text-transform: uppercase;
    color: #fff;
    max-width: 22ch;
    border-left: 4px solid var(--orange-500);
    padding-left: clamp(1rem, 2vw, 1.75rem);
  }

  /* ---------- BREAKPOINTS ---------- */
  @media (min-width: 800px) {
    .commit {
      grid-template-columns: 190px 1fr;
      gap: clamp(2rem, 4vw, 4rem);
    }
    .pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.5rem, 3vw, 3rem);
    }
  }
  @media (min-width: 980px) {
    .compliance__grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
    .training {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .closing__inner {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .shero {
      display: block;
      position: relative;
      height: clamp(600px, calc(100svh - var(--header-h)), 900px);
    }
    .shero__media {
      position: absolute;
      inset: 0;
      z-index: 0;
      aspect-ratio: auto;
    }
    .shero__plate-wrap {
      position: absolute;
      inset-inline: 0;
      bottom: 0;
      padding-inline: max(var(--gutter), calc((100% - 1680px) / 2 + var(--gutter)));
      padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
      pointer-events: none;
    }
    .shero__plate {
      pointer-events: auto;
      width: min(760px, 58%);
      background: transparent;
      box-shadow: none;
      padding: 0;
    }
    .shero__plate::before {
      display: none;
    }
  }
</style>
