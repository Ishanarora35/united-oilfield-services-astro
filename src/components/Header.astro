---
import { Image } from 'astro:assets';
import logoWhite from '@/assets/brand/uos-logo-wordmark-white.png';
import { nav, site } from '@/data/site';
import { services } from '@/data/services';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="hdr" id="site-header" data-header>
  <div class="hdr__inner shell shell--wide">
    <a href="/" class="hdr__logo" aria-label={`${site.name} — home`}>
      <Image
        src={logoWhite}
        alt={site.name}
        widths={[250, 500, 760]}
        sizes="(max-width: 900px) 190px, 250px"
        format="webp"
        quality={92}
        loading="eager"
      />
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) =>
            item.href === '/services' ? (
              <li>
                <button
                  type="button"
                  class:list={['hdr__link hdr__link--btn', { 'is-current': isCurrent(item.href) }]}
                  aria-expanded="false"
                  aria-controls="services-panel"
                  data-panel-toggle
                >
                  {item.label}
                  <svg
                    class="hdr__chev"
                    width="10"
                    height="7"
                    viewBox="0 0 10 7"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d="M1 1.2 5 5.2l4-4" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                </button>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class:list={['hdr__link', { 'is-current': isCurrent(item.href) }]}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="hdr__actions">
      <a href={site.contact.phoneHref} class="hdr__phone">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>{site.contact.phone}</span>
      </a>
      <a href="/contact" class="btn btn--accent btn--sm hdr__cta">Get in Touch</a>

      <button
        type="button"
        class="hdr__burger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Open menu</span>
        <span class="hdr__burger-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <!-- Services mega panel (desktop) -->
  <div class="mega on-dark" id="services-panel" data-panel hidden>
    <div class="mega__inner shell shell--wide">
      <div class="mega__head">
        <p class="eyebrow">Our services</p>
        <p class="mega__lede">
          Eight service divisions covering upstream and midstream operations.
        </p>
        <a href="/services" class="link-arrow mega__all">
          Services overview
          <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
            <path d="M1 6h13M9.5 1 14.5 6l-5 5" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </a>
      </div>

      <ul class="mega__grid">
        {
          services.map((s) => (
            <li>
              <a
                href={`/services/${s.slug}`}
                class:list={['mega__item', { 'is-current': path === `/services/${s.slug}` }]}
                aria-current={path === `/services/${s.slug}` ? 'page' : undefined}
              >
                <span class="mega__num" aria-hidden="true">
                  {s.number}
                </span>
                <span class="mega__body">
                  <span class="mega__title">{s.navTitle}</span>
                  <span class="mega__tag">{s.taglines.join(' ')}</span>
                </span>
                <svg
                  class="mega__arrow"
                  width="16"
                  height="12"
                  viewBox="0 0 16 12"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M1 6h13M9.5 1 14.5 6l-5 5" stroke="currentColor" stroke-width="2" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Full-screen mobile menu -->
  <div class="mnav" id="mobile-menu" data-menu hidden>
    <div class="mnav__inner grid-texture on-dark">
      <nav aria-label="Mobile">
        <ul class="mnav__list">
          {
            nav.map((item, i) =>
              item.href === '/services' ? (
                <li style={`--i:${i}`} class="mnav__group">
                  <button
                    type="button"
                    class:list={['mnav__link mnav__link--btn', { 'is-current': isCurrent(item.href) }]}
                    aria-expanded="false"
                    aria-controls="mnav-services"
                    data-sub-toggle
                  >
                    <span class="mnav__num">{String(i + 1).padStart(2, '0')}</span>
                    <span>{item.label}</span>
                    <svg
                      class="mnav__chev"
                      width="14"
                      height="9"
                      viewBox="0 0 10 7"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path d="M1 1.2 5 5.2l4-4" stroke="currentColor" stroke-width="1.8" />
                    </svg>
                  </button>

                  <ul class="mnav__sub" id="mnav-services" data-sub hidden>
                    <li>
                      <a href="/services" class="mnav__sublink mnav__sublink--all">
                        All services
                      </a>
                    </li>
                    {services.map((s) => (
                      <li>
                        <a href={`/services/${s.slug}`} class="mnav__sublink">
                          <span class="mnav__subnum" aria-hidden="true">
                            {s.number}
                          </span>
                          {s.navTitle}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li style={`--i:${i}`}>
                  <a
                    href={item.href}
                    class:list={['mnav__link', { 'is-current': isCurrent(item.href) }]}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    <span class="mnav__num">{String(i + 1).padStart(2, '0')}</span>
                    <span>{item.label}</span>
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </nav>

      <div class="mnav__foot">
        <span class="angled-rule angled-rule--sm"></span>
        <a href={site.contact.phoneHref} class="mnav__contact">{site.contact.phone}</a>
        <a href={site.contact.emailHref} class="mnav__contact">{site.contact.email}</a>
        <p class="mnav__addr">{site.contact.addressInline}</p>
        <a href="/contact" class="btn btn--accent mnav__cta">
          Get in Touch
          <svg
            class="btn__arrow"
            width="16"
            height="12"
            viewBox="0 0 16 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M1 6h13M9.5 1 14.5 6l-5 5" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--navy-800);
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
    transition:
      background-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .hdr.is-scrolled {
    background: var(--navy-900);
    box-shadow: 0 10px 34px rgba(0, 12, 36, 0.3);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.75rem);
    height: var(--header-h);
    transition: height 0.4s var(--ease);
  }
  .hdr.is-scrolled .hdr__inner {
    height: var(--header-h-compact);
  }

  .hdr__logo {
    flex: none;
    display: block;
    margin-right: auto;
  }
  .hdr__logo :global(img) {
    width: clamp(168px, 20vw, 250px);
    height: auto;
    transition: width 0.4s var(--ease);
  }
  .hdr.is-scrolled .hdr__logo :global(img) {
    width: clamp(150px, 16vw, 205px);
  }

  .hdr__nav {
    display: none;
  }
  .hdr__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 1.9vw, 2rem);
  }
  .hdr__link {
    position: relative;
    display: block;
    padding-block: 0.55rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    white-space: nowrap;
    transition: color 0.3s var(--ease);
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--orange-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }
  .hdr__link:hover,
  .hdr__link:focus-visible,
  .hdr__link.is-current {
    color: #fff;
  }
  .hdr__link:hover::after,
  .hdr__link:focus-visible::after,
  .hdr__link.is-current::after {
    transform: scaleX(1);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.5vw, 1.4rem);
    flex: none;
  }
  .hdr__phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.8);
    white-space: nowrap;
    transition: color 0.3s var(--ease);
  }
  .hdr__phone:hover {
    color: #fff;
  }
  .hdr__phone svg {
    color: var(--orange-500);
    flex: none;
  }
  .hdr__cta {
    display: none;
  }

  /* Panel trigger shares the nav link look */
  .hdr__link--btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font: inherit;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .hdr__chev {
    transition: transform 0.35s var(--ease);
    opacity: 0.8;
  }
  .hdr__link--btn[aria-expanded='true'] {
    color: #fff;
  }
  .hdr__link--btn[aria-expanded='true'] .hdr__chev {
    transform: rotate(180deg);
  }
  .hdr__link--btn[aria-expanded='true']::after {
    transform: scaleX(1);
  }

  /* ---------- SERVICES MEGA PANEL ---------- */
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--navy-900);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 4px solid var(--orange-500);
    box-shadow: 0 30px 60px rgba(0, 12, 36, 0.42);
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.3s var(--ease), transform 0.36s var(--ease-out);
    z-index: 90;
  }
  .mega[hidden] {
    display: none;
  }
  .mega.is-open {
    opacity: 1;
    transform: none;
  }
  .mega__inner {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: clamp(1.75rem, 3vw, 2.75rem);
  }
  .mega__lede {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.15;
    text-transform: uppercase;
    color: #fff;
    max-width: 16ch;
  }
  .mega__all {
    margin-top: 1.25rem;
  }

  .mega__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .mega__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 0.95rem 1.1rem;
    background: var(--navy-900);
    transition: background-color 0.28s var(--ease);
  }
  .mega__item:hover,
  .mega__item:focus-visible,
  .mega__item.is-current {
    background: #00235e;
  }
  .mega__num {
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--orange-500);
    font-variant-numeric: tabular-nums;
  }
  .mega__body {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .mega__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.15;
    color: #fff;
  }
  .mega__tag {
    font-size: 0.78rem;
    line-height: 1.35;
    color: #98a6bd;
  }
  .mega__arrow {
    color: rgba(255, 255, 255, 0.35);
    transition: color 0.28s var(--ease), transform 0.35s var(--ease-out);
  }
  .mega__item:hover .mega__arrow,
  .mega__item:focus-visible .mega__arrow {
    color: var(--orange-500);
    transform: translateX(3px);
  }

  @media (min-width: 1240px) {
    .mega__inner {
      grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
      align-items: start;
    }
    .mega__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega {
      transition: none;
      transform: none;
    }
  }

  /* Burger */
  .hdr__burger {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-right: -8px;
    color: #fff;
  }
  .hdr__burger-bars {
    display: block;
    width: 26px;
    height: 14px;
    position: relative;
  }
  .hdr__burger-bars i {
    position: absolute;
    left: 0;
    height: 2px;
    width: 100%;
    background: currentColor;
    transition: transform 0.4s var(--ease-out), opacity 0.25s var(--ease);
  }
  .hdr__burger-bars i:nth-child(1) {
    top: 0;
  }
  .hdr__burger-bars i:nth-child(2) {
    top: 6px;
    width: 70%;
  }
  .hdr__burger-bars i:nth-child(3) {
    top: 12px;
  }
  .hdr__burger[aria-expanded='true'] i:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .hdr__burger[aria-expanded='true'] i:nth-child(2) {
    opacity: 0;
  }
  .hdr__burger[aria-expanded='true'] i:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---------- MOBILE MENU ---------- */
  .mnav {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 99;
    background: var(--navy-900);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease-out);
  }
  .mnav[hidden] {
    display: none;
  }
  .mnav.is-open {
    opacity: 1;
    transform: none;
  }
  .hdr.is-scrolled .mnav {
    inset-block-start: var(--header-h-compact);
  }
  .mnav__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding: clamp(1.75rem, 6vw, 3rem) var(--gutter) calc(2.5rem + env(safe-area-inset-bottom));
  }
  .mnav__list {
    display: grid;
  }
  .mnav__list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
    opacity: 0;
    transform: translateY(14px);
  }
  .mnav.is-open .mnav__list li {
    animation: mnavIn 0.5s var(--ease-out) forwards;
    animation-delay: calc(60ms * var(--i) + 90ms);
  }
  @keyframes mnavIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .mnav__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(0.85rem, 2.4vw, 1.15rem);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 7vw, 2.5rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.05;
    color: #fff;
    transition: color 0.25s var(--ease), transform 0.35s var(--ease-out);
  }
  .mnav__link:hover,
  .mnav__link.is-current {
    color: var(--orange-400);
  }
  .mnav__num {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--orange-500);
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .mnav__foot {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
  }
  .mnav__foot .angled-rule {
    margin-bottom: 0.7rem;
  }
  .mnav__contact {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
  }
  .mnav__contact:hover {
    color: var(--orange-400);
  }
  .mnav__addr {
    font-size: 0.9rem;
    color: var(--text-invert-soft);
  }
  .mnav__cta {
    margin-top: 1rem;
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .mnav__list li {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }

  /* ---------- MOBILE SERVICES SUB-MENU ---------- */
  .mnav__link--btn {
    width: 100%;
    text-align: left;
  }
  .mnav__chev {
    margin-left: auto;
    color: var(--orange-500);
    transition: transform 0.35s var(--ease);
    flex: none;
    align-self: center;
  }
  .mnav__link--btn[aria-expanded='true'] .mnav__chev {
    transform: rotate(180deg);
  }
  .mnav__sub {
    display: grid;
    gap: 0;
    padding-bottom: 0.9rem;
  }
  .mnav__sub[hidden] {
    display: none;
  }
  .mnav__sublink {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.72rem 0 0.72rem 2.35rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-invert-soft);
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    transition: color 0.25s var(--ease);
  }
  .mnav__sublink:hover,
  .mnav__sublink:focus-visible {
    color: var(--orange-400);
  }
  .mnav__sublink--all {
    color: #fff;
    padding-left: 2.35rem;
  }
  .mnav__subnum {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--orange-500);
    flex: none;
  }

  /* ---------- BREAKPOINTS ---------- */
  @media (min-width: 560px) {
    .mnav__cta {
      width: auto;
      min-width: 260px;
    }
  }
  @media (min-width: 700px) {
    .hdr__cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1080px) {
    .hdr__nav {
      display: block;
    }
    .hdr__burger {
      display: none;
    }
    .mnav {
      display: none !important;
    }
  }
  @media (min-width: 1300px) {
    .hdr__phone {
      display: inline-flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  // Compact header on scroll
  if (header) {
    let ticking = false;
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  // ---------- Services mega panel (desktop) ----------
  const panelToggle = document.querySelector<HTMLButtonElement>('[data-panel-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-panel]');

  if (panelToggle && panel) {
    let closeTimer = 0;

    const openPanel = () => {
      window.clearTimeout(closeTimer);
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add('is-open'));
      panelToggle.setAttribute('aria-expanded', 'true');
    };

    const closePanel = (restoreFocus = false) => {
      panel.classList.remove('is-open');
      panelToggle.setAttribute('aria-expanded', 'false');
      closeTimer = window.setTimeout(() => {
        panel.hidden = true;
      }, 300);
      if (restoreFocus) panelToggle.focus();
    };

    const isOpen = () => panelToggle.getAttribute('aria-expanded') === 'true';

    panelToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closePanel() : openPanel();
    });

    // Close when a service is chosen, when focus or the pointer leaves, or on Escape
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) closePanel();
    });

    document.addEventListener('click', (e) => {
      if (!isOpen()) return;
      const t = e.target as Node;
      if (!panel.contains(t) && !panelToggle.contains(t)) closePanel();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) closePanel(true);
    });

    document.addEventListener('focusin', (e) => {
      if (!isOpen()) return;
      const t = e.target as Node;
      if (!panel.contains(t) && !panelToggle.contains(t)) closePanel();
    });

    // A dropdown pinned to the header makes no sense once the mobile menu takes over
    window.matchMedia('(max-width: 1079px)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) closePanel();
    });
  }

  // ---------- Mobile services sub-menu ----------
  const subToggle = document.querySelector<HTMLButtonElement>('[data-sub-toggle]');
  const sub = document.querySelector<HTMLElement>('[data-sub]');
  if (subToggle && sub) {
    subToggle.addEventListener('click', () => {
      const open = subToggle.getAttribute('aria-expanded') === 'true';
      subToggle.setAttribute('aria-expanded', String(!open));
      sub.hidden = open;
    });
  }

  // Mobile menu
  if (toggle && menu) {
    let lastFocus: HTMLElement | null = null;

    const openMenu = () => {
      lastFocus = document.activeElement as HTMLElement;
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('is-open'));
      toggle.setAttribute('aria-expanded', 'true');
      toggle.querySelector('.visually-hidden')!.textContent = 'Close menu';
      document.body.style.overflow = 'hidden';
      menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    const closeMenu = (restore = true) => {
      menu.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.querySelector('.visually-hidden')!.textContent = 'Open menu';
      document.body.style.overflow = '';
      window.setTimeout(() => {
        menu.hidden = true;
      }, 320);
      if (restore) (lastFocus ?? toggle).focus();
    };

    toggle.addEventListener('click', () => {
      toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
    });

    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) closeMenu(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') closeMenu();
    });

    // Focus trap while open
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || toggle.getAttribute('aria-expanded') !== 'true') return;
      const focusables = [
        toggle,
        ...Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
          (el) => el.offsetParent !== null,
        ),
      ];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Reset when resizing up to desktop
    const mq = window.matchMedia('(min-width: 1080px)');
    mq.addEventListener('change', (e) => {
      if (e.matches && toggle.getAttribute('aria-expanded') === 'true') closeMenu(false);
    });
  }
</script>
