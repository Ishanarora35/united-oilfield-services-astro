---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Intermediate crumbs between Home and the current page. */
  breadcrumb?: { label: string; href: string }[];
  /** Set false to hide the trail entirely. */
  crumbs?: boolean;
  /** Photograph shown behind the heading. */
  image?: ImageMetadata;
  imageAlt?: string;
  objectPosition?: string;
}
const {
  eyebrow,
  title,
  lead,
  breadcrumb = [],
  crumbs = true,
  image,
  imageAlt = '',
  objectPosition = '50% 50%',
} = Astro.props;
---

<section class:list={['phero', 'on-dark', image ? 'phero--photo' : 'grid-texture']}>
  {
    image && (
      <div class="phero__media">
        <Image
          src={image}
          alt={imageAlt}
          widths={[800, 1280, Math.min(image.width, 1900)]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          quality={84}
          style={`object-position:${objectPosition}`}
        />
        <span class="photo-scrim" aria-hidden="true" />
      </div>
    )
  }

  <div class="shell phero__shell">
    {
      crumbs && (
        <nav class="phero__crumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            {breadcrumb.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))}
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
      )
    }
    <div class="phero__body">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="phero__title hero-title">{title}</h1>
      <span class="angled-rule phero__rule"></span>
      {lead && <p class="lead phero__lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .phero {
    background: var(--navy-800);
    color: #fff;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
    position: relative;
    isolation: isolate;
  }
  .phero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 5px;
    z-index: 3;
    background: linear-gradient(to right, var(--navy-700) 0 58%, var(--orange-500) 58%);
  }

  /* ---------- PHOTO VARIANT ---------- */
  .phero--photo {
    background: var(--navy-950);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
    display: grid;
    align-items: end;
    min-height: clamp(420px, 62vw, 620px);
  }
  /* Reaches further up the frame so the breadcrumb stays legible over bright skies */
  .phero--photo .photo-scrim {
    background:
      linear-gradient(
        to top,
        rgba(0, 15, 43, 0.88) 0%,
        rgba(0, 15, 43, 0.62) 28%,
        rgba(0, 15, 43, 0.26) 54%,
        rgba(0, 15, 43, 0) 82%
      ),
      linear-gradient(
        105deg,
        rgba(0, 15, 43, 0.72) 0%,
        rgba(0, 15, 43, 0.34) 36%,
        rgba(0, 15, 43, 0) 58%
      );
  }
  .phero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .phero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phero__shell {
    position: relative;
    z-index: 2;
  }

  .phero__crumbs {
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .phero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-family: var(--font-display);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
  }
  .phero__crumbs li + li::before {
    content: '/';
    margin-right: 0.75rem;
    color: var(--orange-500);
  }
  .phero__crumbs a {
    transition: color 0.25s var(--ease);
  }
  .phero__crumbs a:hover {
    color: #fff;
  }
  .phero__crumbs [aria-current] {
    color: #fff;
  }

  .phero__title {
    margin-block: 1.1rem 0;
    max-width: 22ch;
  }
  .phero__rule {
    margin-top: 1.4rem;
  }
  .phero__lead {
    margin-top: 1.35rem;
    max-width: 58ch;
    color: #dce4f0;
  }
  .phero--photo .phero__lead,
  .phero--photo .phero__crumbs ol {
    text-shadow: 0 1px 12px rgba(0, 12, 36, 0.55);
  }

  /* Photo heroes match the homepage hero's presence on desktop */
  @media (min-width: 1024px) {
    .phero--photo {
      min-height: clamp(600px, calc(100svh - var(--header-h)), 900px);
    }
  }
</style>
