---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { site } from '@/data/site';
import ctaImg from '@/assets/home/hero-4-pumpjack-flare.jpg';
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  eyebrow = 'Start a conversation',
  title = 'Tell us about your next project',
  body = 'Whatever the size, scope or location, our team is ready to scope the work and put the right crews on your site.',
  primaryLabel = 'Contact UOS',
  primaryHref = '/contact',
  secondaryLabel = 'Explore Our Services',
  secondaryHref = '/services',
} = Astro.props;
---
<section class="cta on-dark">
  <div class="cta__media" aria-hidden="true">
    <Image src={ctaImg} alt="" widths={[900, 1400]} sizes="100vw" loading="lazy" quality={80} />
    <span class="photo-scrim"></span>
  </div>
  <div class="shell cta__shell">
    <div class="cta__inner reveal">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="cta__title">{title}</h2>
        <p class="cta__body">{body}</p>
      </div>
      <div class="cta__side">
        <div class="btn-row">
          <a href={primaryHref} class="btn btn--accent">{primaryLabel}<Arrow /></a>
          <a href={secondaryHref} class="btn btn--on-dark">{secondaryLabel}</a>
        </div>
        <div class="cta__direct">
          <a href={site.contact.phoneHref} class="cta__phone">{site.contact.phone}</a>
          <a href={site.contact.emailHref} class="cta__email">{site.contact.email}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--navy-950);
    color: #fff;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    position: relative;
    isolation: isolate;
  }
  .cta__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .cta__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 55%;
  }
  .cta__shell {
    position: relative;
    z-index: 2;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 5px;
    z-index: 3;
    background: linear-gradient(to right, var(--navy-700) 0 55%, var(--orange-500) 55%);
  }
  .cta__inner { display: grid; gap: 2.5rem; align-items: end; }
  .cta__title {
    font-size: var(--fs-hero);
    line-height: 1.02;
    color: #fff;
    margin-top: 1.15rem;
    max-width: 22ch;
    text-shadow: 0 2px 18px rgba(0, 12, 36, 0.5);
  }
  .cta__body {
    margin-top: 1.15rem;
    max-width: 52ch;
    color: #dce4f0;
    font-size: var(--fs-body-lg);
    text-shadow: 0 1px 12px rgba(0, 12, 36, 0.55);
  }
  .cta__side { display: grid; gap: 2rem; }
  .cta__direct {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,.2);
  }
  .cta__phone, .cta__email {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    transition: color .25s var(--ease);
  }
  .cta__phone { font-size: 1.5rem; }
  .cta__email { font-size: 1.15rem; align-self: center; word-break: break-word; }
  .cta__phone:hover, .cta__email:hover { color: var(--orange-400); }

  @media (min-width: 980px) {
    .cta__inner { grid-template-columns: 1.05fr 0.95fr; gap: 4rem; }
  }
</style>
